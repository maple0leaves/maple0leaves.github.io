<article class="article-page">
  <a class="back-link" href="<%- url_for('/') %>">← 返回首页</a>
  <div class="article-kicker"><%= page.categories.length ? page.categories.toArray()[0].name : '随笔' %> <span>·</span> <time datetime="<%= date(page.date, 'YYYY-MM-DD') %>"><%= date(page.date, 'YYYY年M月D日') %></time></div>
  <h1><%= page.title %></h1>
  <div class="article-rule"></div>
  <div class="prose"><%- page.content %></div>
  <div class="article-end">✳</div>
</article>
