<section class="archive-page"><div class="section-kicker">ARCHIVE</div><h1>所有文章</h1><p class="archive-intro">时间留下的痕迹，都收在这里。</p>
  <% var posts = page.posts.sort('date', -1); var year = ''; posts.each(function(post) { var postYear = date(post.date, 'YYYY'); if (postYear !== year) { if (year) { %></div><% } year = postYear; %><h2><%= year %></h2><div class="archive-list"><% } %>
    <div class="archive-row"><time datetime="<%= date(post.date, 'YYYY-MM-DD') %>"><%= date(post.date, 'MM.DD') %></time><a href="<%- url_for(post.path) %>"><%= post.title %></a><span aria-hidden="true">↗</span></div>
  <% }); if (year) { %></div><% } %>
</section>
